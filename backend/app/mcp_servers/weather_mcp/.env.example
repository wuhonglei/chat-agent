# 和风天气 MCP Server 配置示例
# 复制此文件为 config.env 并填入您的 API Key

# 和风天气 API Key（必填）
# 获取方式：https://dev.qweather.com/
QWEATHER_API_KEY=your_api_key_here

# API 基础 URL（可选，默认为开发环境）
# 开发环境：https://devapi.qweather.com
# 商业环境：https://api.qweather.com
QWEATHER_BASE_URL=https://pb6hewdvet.re.qweatherapi.com

# 请求超时时间（秒，可选，默认10秒）
QWEATHER_TIMEOUT=10
