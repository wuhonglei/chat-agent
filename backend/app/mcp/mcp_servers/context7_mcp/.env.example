# Context7 API 配置
# 获取 API Key: https://context7.com
CONTEXT7_API_KEY=your_context7_api_key

# 可选：远程 MCP 地址（默认 https://mcp.context7.com/mcp）
# CONTEXT7_URL=https://mcp.context7.com/mcp

# 可选：是否验证 SSL（默认 true）
# CONTEXT7_VERIFY_SSL=true

# 可选：是否启用 ResponseCachingMiddleware 缓存
# CONTEXT7_CACHE_ENABLED=false

# 可选：缓存目录（默认 ./data/mcp_cache/context7）
# CONTEXT7_CACHE_DIR=./data/mcp_cache/context7

# 可选：工具调用缓存 TTL（秒，默认 300）
# CONTEXT7_CALL_TOOL_TTL=300
