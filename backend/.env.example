# Application Settings
APP_NAME="AI Doc Q&A System"
APP_VERSION="0.1.0"
DEBUG=True
HOST=0.0.0.0
PORT=8000

# LLM API Configuration
LLM_API_KEY=sk-***
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_THINK_MODEL=deepseek-reasoner

# Web Search
TAVILY_API_KEY=tvly-dev-***

# External Integrations
# Confluence
CONFLUENCE_URL=https://your-domain.atlassian.net
CONFLUENCE_PERSONAL_TOKEN=your_confluence_api_token

# Storage
AVATAR_DIR=./data/avatars

# Security (for future use)
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=./private_keys/v1_private_key.pem
JWT_PUBLIC_KEY_PATH=./private_keys/v1_public_key.pem

# Cloudbase env id
CLOUDBASE_ENV_ID=ai-assistant-***

# 腾讯云对象存储服务
STORAGE_SECRET_ID=***
STORAGE_SECRET_KEY=***  # 替换为实际SecretKey
STORAGE_REGION=ap-guangzhou  # 替换为实际地域
STORAGE_BUCKET=ai-chat-1258352625  # 替换为实际存储桶名

# PostgreSQL database
PG_HOST=localhost
PG_PORT=5432
PG_DB=ai_assistant_db
PG_USER_NAME=wuhonglei
PG_PASSWORD=***

# MCP Config
CONTEXT7_API_KEY=ctx7sk-***