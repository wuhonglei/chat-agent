# Nacos 配置中心连接信息
# 复制此文件为 .env 并填入实际的配置值

# Nacos 服务地址（多个地址用逗号分隔，如 "ip1:8848,ip2:8848"）
NACOS_SERVER_ADDRESSES=localhost:8848

# Nacos 命名空间ID（默认public，自定义命名空间需填ID而非名称）
# 如果使用默认命名空间，可以留空或设置为空字符串
NACOS_NAMESPACE=

# Nacos 登录用户名（如果 Nacos 未开启认证，可以留空）
NACOS_USERNAME=nacos

# Nacos 登录密码（如果 Nacos 未开启认证，可以留空）
NACOS_PASSWORD=nacos

# 配置ID（必填）
NACOS_DATA_ID=chat-agent-backend-config

# 配置分组（默认DEFAULT_GROUP）
NACOS_GROUP=DEFAULT_GROUP

# 配置格式（支持：yaml/json/properties/text，默认yaml）
NACOS_CONFIG_TYPE=yaml
