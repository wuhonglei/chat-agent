# Application Settings
APP_NAME="AI Doc Q&A System"
APP_VERSION="0.1.0"
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# LLM API Configuration
LLM_API_KEY=xxx
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_THINK_MODEL=deepseek-reasoner

# Embedding API Configuration
EMBEDDING_API_KEY=yyy
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# Re-rank API Configuration
RE_RANK_API_KEY=zzz
RE_RANK_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
RE_RANK_MODEL=gte-rerank-v2

# Chroma Vector Database
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./data/vectordb
CHROMA_COLLECTION_NAME=documents

# Document Processing
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt,md
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Web Search
TAVILY_API_KEY=your_tavily_api_key

# External Integrations
# Confluence
CONFLUENCE_URL=https://your-domain.atlassian.net
CONFLUENCE_PERSONAL_TOKEN=your_confluence_api_token

# Google Workspace
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL=3600

# Storage
UPLOAD_DIR=./data/documents
TEMP_DIR=./data/temp

# Search Settings
SEARCH_TOP_K=10
USE_RERANK=True
RERANK_TOP_K=3
MIN_RELEVANCE_SCORE=0.3

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_ROTATION="10 MB"
LOG_RETENTION="30 days"

# Security (for future use)
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=ai_assistant_db
PG_USER_NAME=***
PG_PASSWORD=***

# MCP Config
CONTEXT7_API_KEY=***