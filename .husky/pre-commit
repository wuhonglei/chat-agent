#!/usr/bin/env sh
set -e

cd "$(dirname "$0")/.."

cd frontend
if [ -f "$HOME/.vite-plus/env" ]; then
  . "$HOME/.vite-plus/env"
fi
vp staged
cd ..


# Backend: ruff + mypy（.pre-commit-config.yaml，仅对暂存的 .py 做类型检查）
# pre-commit 在 optional-dependencies dev 中，需 --extra dev 才能找到可执行文件
(cd backend && uv run --extra dev pre-commit run)
