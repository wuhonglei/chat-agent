# PostgreSQL 数据库配置
# 复制此文件为 .env 并填入实际值
# 注意：这些用户和数据库会由 Docker 自动创建
PG_USER_NAME=wuhonglei
PG_PASSWORD=your_secure_password_here

# 其他必需的环境变量
LLM_API_KEY=your_llm_api_key
EMBEDDING_API_KEY=your_embedding_api_key
RE_RANK_API_KEY=your_rerank_api_key
CLOUDBASE_ENV_ID=your_cloudbase_env_id
STORAGE_SECRET_ID=your_storage_secret_id
STORAGE_SECRET_KEY=your_storage_secret_key
